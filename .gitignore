# Ignore node_modules
/frontend/node_modules
/backend/node_modules

# Ignore environment variables
/backend/.env
/backend/.env.production
/backend/.env.staging

# Ignore logs
*.log
logs

# Ignore build and dist directories
/frontend/build
/frontend/dist
/backend/build

# Ignore IDE settings
.vscode/
.idea/

# Ignore package lock files (covers both frontend & backend)
package-lock.json
yarn.lock

# Ignore operating system files
.DS_Store

# Ignore coverage directory from test runs
/coverage
